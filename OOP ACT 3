## Python Implementation
class Food:
    def __init__(self, name, calories):
        self.name = name
        self.calories = calories
        self.eaten_by = []  # Many players can eat this food

    def __repr__(self):
        return f"{self.name} ({self.calories} cal)"

class SportsPlayer:
    def __init__(self, name, sport):
        self.name = name
        self.sport = sport
        self.foods = []  # Many foods can be eaten by this player
        self.special_moves = 3
        self.vacancy = True

    def eat(self, food):
        # Many-to-Many link
        if food not in self.foods:
            self.foods.append(food)
        if self not in food.eaten_by:
            food.eaten_by.append(self)
        print(f"{self.name} eats {food.name}")

    def Swing(self):
        print(f"{self.name} swings!")

    def blast(self):
        print(f"{self.name} blasts!")

    def MultiplayerAim(self, num_players):
        print(f"{num_players} players aiming together!")

    def show_diet(self):
        print(f"\n{self.name}'s Diet: {self.foods}")

