## Python Implementation
--- PUBLIC INFO ---
Coach: Coach Santos
Victories: 15 Wins - 2 Losses

--- PRIVATE INFO (Opponent tries) ---
Access Denied: Private information

--- PRIVATE INFO (Team member tries) ---
Members: [10, 23, 7, 15, 30], Schedule: Monday & Wednesday - 5PMclass Team:
    def __init__(self, team_members, schedule, coach, victories):
        self.__team_members = team_members  # Private: integers
        self.__schedule = schedule          # Private: string
        self.coach = coach                  # Public: string
        self.victories = victories          # Public: string

    # Getter for private attributes (for team use only)
    def get_team_info(self, password):
        if password == "team_only":
            return f"Members: {self.__team_members}, Schedule: {self.__schedule}"
        else:
            return "Access Denied: Private information"

    def display_public_info(self):
        print(f"Coach: {self.coach}")
        print(f"Victories: {self.victories}")
# TEST RUN
my_team = Team(
    team_members = [10, 23, 7, 15, 30],
    schedule = "Monday & Wednesday - 5PM",
    coach = "Coach Santos",
    victories = "15 Wins - 2 Losses"
)

# 1. Public Access Test (Anyone can see)
print("--- PUBLIC INFO ---")
my_team.display_public_info()

# 2. Private Access Test (Opponent tries to see)
print("\n--- PRIVATE INFO (Opponent tries) ---")
print(my_team.get_team_info(password="opponent"))

# 3. Private Access Test (Team member tries to see)
print("\n--- PRIVATE INFO (Team member tries) ---")
print(my_team.get_team_info(password="team_only"))
