## Python Implementation
class Nutrient:
    def __init__(self, name, amount):
        self.name = name
        self.amount = amount

    def show_nutrient(self):
        print(self.name + ":", self.amount, "g")


class Food:
    def __init__(self, name):
        self.name = name
        self.nutrients = []

    def add_nutrient(self, nutrient):
        self.nutrients.append(nutrient)

    def show_food(self):
        print("\nFood:", self.name)
        for nutrient in self.nutrients:
            nutrient.show_nutrient()


class Carbohydrate(Nutrient):
    def __init__(self, amount):
        super().__init__("Carbohydrates", amount)


class Vitamin(Nutrient):
    def __init__(self, name, amount):
        super().__init__(name, amount)


rice = Food("Rice")
rice.add_nutrient(Carbohydrate(45))
rice.add_nutrient(Vitamin("Vitamin B1", 0.2))

banana = Food("Banana")
banana.add_nutrient(Carbohydrate(23))
banana.add_nutrient(Vitamin("Vitamin C", 8.7))

potato = Food("Potato")
potato.add_nutrient(Carbohydrate(17))
potato.add_nutrient(Vitamin("Vitamin C", 19.7))

rice.show_food()
banana.show_food()
potato.show_food()

